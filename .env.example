# SevaDristi Production Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL

# Application Mode
# Set to 'false' in production. Setting to 'true' enables synthetic demo presets.
DEMO_MODE=false

# Security & QR Token Cryptography (Required in production)
# 64-character hex string or strong entropy secret key for HMAC-SHA256 signature
SEVADRISTI_QR_SECRET=replace_with_64_character_hex_secure_random_key_in_production
# Previous secret key for seamless zero-downtime key rotation
SEVADRISTI_QR_SECRET_OLD=

# Database Connection (PostgreSQL async engine)
DATABASE_URL=postgresql+asyncpg://sevadristi_user:sevadristi_password@postgres:5432/sevadristi_audit

# Ephemeral Session Cache (Redis)
REDIS_URL=redis://redis:6379/0

# Logging & Observability
LOG_LEVEL=INFO
# SENTRY_DSN=https://public@sentry.example.gov.in/1

# Rate Limiting & Capacity
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=10485760

# Scheme Rules Catalog Path (Defaults to backend/rules/schemes.json if omitted)
RULES_FILE_PATH=backend/rules/schemes.json

# Production Web Server Settings
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=4
